# ORCA Production Environment Configuration Checklist

# AI & Speech Services
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GNANI_API_KEY=your_gnani_vachana_api_key_here

# Runtime Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
DEMO_MODE=true

# Database and Cache
DATABASE_PATH=./data/decisions.db
CACHE_TTL_SECONDS=3600

# CORS Allowed Origins (Comma-separated list of deployed frontend origins)
ALLOWED_ORIGINS=https://your-orca-frontend.vercel.app

# External Marine Data Providers
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
